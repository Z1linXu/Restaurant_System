ARG BASE_IMAGE
FROM ${BASE_IMAGE}
ARG RELEASE_VERSION
ARG SOURCE_SHA
ARG PATCH_SHA256
LABEL org.opencontainers.image.revision=${RELEASE_VERSION} \
      com.restaurant.source-revision=${SOURCE_SHA} \
      com.restaurant.compatibility-patch=${PATCH_SHA256}
COPY --chown=10001:10001 app.jar /app/app.jar
