# Staging only. Copy outside the release worktree to:
# /srv/restaurant-pos/staging/config/.env.staging
# Never copy production .env values into this file and never commit the filled file.

COMPOSE_PROJECT_NAME=restaurant-pos-staging
STAGING_ROOT=/srv/restaurant-pos/staging
STAGING_COMMIT_SHA=<approved-full-40-character-git-sha>
STAGING_POSTGRES_DATA_DIR=/srv/restaurant-pos/staging/state/postgres

# The initial staging service is loopback-only HTTP. TLS/domain/0.0.0.0 are forbidden.
HTTP_BIND_ADDRESS=127.0.0.1
HTTP_PORT=18080
NGINX_SERVER_NAME=localhost
TZ=America/Toronto

POSTGRES_IMAGE_TAG=16-alpine
DB_NAME=restaurant_pos_staging
DB_USER=restaurant_pos_staging
DB_PASSWORD=<generate-unique-staging-password-at-least-16-characters>
JWT_SECRET=<generate-unique-staging-jwt-secret-at-least-32-characters>
SPRING_PROFILES_ACTIVE=cloud
JAVA_OPTS=-Xms128m -Xmx512m

# Each image tag and build version must include the exact STAGING_COMMIT_SHA.
BACKEND_IMAGE=restaurant-pos-backend:staging-<approved-full-40-character-git-sha>
FRONTEND_IMAGE=restaurant-pos-frontend:staging-<approved-full-40-character-git-sha>
VITE_APP_BUILD_VERSION=staging-<approved-full-40-character-git-sha>

# These are staging resource caps, not production defaults.
STAGING_DB_CPU_LIMIT=0.75
STAGING_DB_MEMORY_LIMIT=512m
STAGING_BACKEND_CPU_LIMIT=1.00
STAGING_BACKEND_MEMORY_LIMIT=768m
STAGING_NGINX_CPU_LIMIT=0.25
STAGING_NGINX_MEMORY_LIMIT=128m
STAGING_LOG_MAX_SIZE=10m
STAGING_LOG_MAX_FILE=3

# This is an operator guard. Store rows must be created with DISABLED;
# only a bounded MOCK smoke test may change a synthetic Store to MOCK.
STAGING_PRINT_MODE=DISABLED
STAGING_PRINTING_FEATURE_ENABLED=false
# STAGING_PRINTER_ENDPOINT must remain unset. Do not add real printer addresses.
