# Backend-only template. Spring does not auto-load this file. Never commit a filled copy.
# Existing disabled optional integration must not prevent ordinary POS startup.
UBER_EATS_ENABLED=false
UBER_EATS_WORKER_ENABLED=false
UBER_EATS_ENVIRONMENT=production
UBER_EATS_PROCESSING_MODE=KITCHEN_MIRROR
UBER_EATS_SCOPES=eats.store eats.store.orders.read
# Independent PROD App credentials, securely injected by the authorized operator.
# Receive-only may omit OAuth credentials; token retrieval cannot.
UBER_EATS_CLIENT_ID=
UBER_EATS_CLIENT_SECRET=
# Required explicitly before UBER_EATS_ENABLED=true; do not reuse TEST signing keys.
UBER_EATS_WEBHOOK_SIGNING_KEY=
# Required UTC ISO-8601 Z instant before Production worker=true. Leave blank while paused.
# This does not replay previously HELD_RECEIVE_ONLY receipts.
UBER_EATS_PROCESSING_NOT_BEFORE=
# Production worker additionally requires at least one explicit Store activation.
# JSON object: exact Uber Store UUID -> ISO-8601 UTC Z cutover. No entry = held.
# Effective boundary is max(global, Store); only advance the paused Store on resume.
UBER_EATS_STORE_CUTOVERS={}
# Production runtime must separately have APP_ENVIRONMENT=production.
# Do not copy UBER_EATS_TEST_WEBHOOK_CLIENT_ID / STORE_ID into Production.
# See deployment/cloud/README_UBER_PRODUCTION_WEBHOOK.md before any runtime change.
