# Backend only. Supply through your process environment; Spring does not auto-load this file.
UBER_EATS_ENABLED=false
UBER_EATS_ENVIRONMENT=sandbox
# Legacy compatible default. For Kitchen Mirror use KITCHEN_MIRROR and
# UBER_EATS_SCOPES=eats.store eats.store.orders.read. This is a global ceiling,
# not a substitute for a Store's persisted processing mode/module/binding.
UBER_EATS_PROCESSING_MODE=ORDER_MANAGER
UBER_EATS_CLIENT_ID=
UBER_EATS_CLIENT_SECRET=
UBER_EATS_WEBHOOK_SIGNING_KEY=
UBER_EATS_SCOPES=eats.order eats.store.orders.read
# Worker false allows durable HELD_RECEIVE_ONLY receipts without importing orders.
# Held notifications are not replayed by subsequently enabling the worker.
UBER_EATS_WORKER_ENABLED=true
# Optional Sandbox UTC boundary; required before any enabled Production worker.
UBER_EATS_PROCESSING_NOT_BEFORE=
# Store/menu mappings are database records configured through authenticated admin APIs.
# Use .env.uber-eats-production.example for the safer Production receive-only defaults.
